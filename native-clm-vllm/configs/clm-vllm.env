# Resource settings only. The scientific grid and official CLM sampling are fixed.
# Copy this file before changing it, then pass --config /absolute/path/to/copy.env.
# All models use the same backend, BF16 precision, and one H200 per GPU task.

CLM_ACCOUNT="${USER%%_*}"
CLM_QOS=normal
CLM_CPU_PARTITION=day
CLM_GPU_PARTITION=gpu_h200
CLM_GPU_TYPE=h200
CLM_PARALLEL=1

PROJECT_DIR="${PROJECT_DIR:-/nfs/roberts/project/${USER%%_*}/${USER}}"
SCRATCH_DIR="${SCRATCH_DIR:-/nfs/roberts/scratch/${USER%%_*}/${USER}}"
CLM_RUNS_DIR="${PROJECT_DIR}/runs"
HF_HOME="${PROJECT_DIR}/hf_cache"
UV_CACHE_DIR="${SCRATCH_DIR}/uv_cache"
VLLM_CACHE_ROOT="${SCRATCH_DIR}/vllm_cache"
TRITON_CACHE_DIR="${SCRATCH_DIR}/triton_cache"
CLM_IMAGE="${PROJECT_DIR}/containers/contextbench.sif"
CONTAINER_MODULE="${CONTAINER_MODULE:-}"

CLM_SETUP_CPUS=8
CLM_SETUP_MEM=64G
CLM_SETUP_TIME=12:00:00
CLM_GPU_CPUS=8
CLM_GPU_MEM=128G
CLM_GPU_TIME=1-00:00:00
CLM_REPORT_CPUS=2
CLM_REPORT_MEM=8G
CLM_REPORT_TIME=01:00:00

# Server limits are separate from the fixed 32768-token o200k benchmark budget.
CLM_MAX_MODEL_LEN=81920
CLM_GPU_MEMORY_UTILIZATION=0.90
CLM_SERVER_READY_TIMEOUT=3600
